<?xml version='1.0' ?>
<BuildGraph xmlns="http://www.epicgames.com/BuildGraph" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.epicgames.com/BuildGraph ../../../../Engine/Build/Graph/Schema.xsd">
    <Option Name="ProjectFile" DefaultValue="" Restrict=".*" Description="Path to the project file. Can be used instead of specifying ProjectName and ProjectPath separately."/>

	<Property Name="DefaultProjectName" Value="None"/>
	<Property Name="DefaultProjectPath" Value="None"/>
	<Regex Input="$(ProjectFile)" Pattern="(.*)[/\\]([^/\\]+)\.uproject" Capture="DefaultProjectPath;DefaultProjectName" If="'$(ProjectFile)' != ''"/>
    <Option Name="ProjectName" DefaultValue="$(DefaultProjectName)" Restrict=".+" Description="Name of Project"/>
	<Option Name="ProjectPath" DefaultValue="$(DefaultProjectPath)" Restrict=".+" Description="Path to the folder that contains your project"/>

    <Option Name="Skip_Validation_All" DefaultValue="false" Restrict="true|false" Description="Skip all validation checks?" />	
    <Option Name="Skip_Validation_NamingConventionValidation" Restrict="true|false" DefaultValue="false" Description="Skip the Naming Convention validation?" />
    <Option Name="Skip_Validation_CheckNoRedirectors" Restrict="true|false" DefaultValue="false" Description="Skip the Check No Redirectors validation?" />

    <Property Name="WithWin64" Value="True" />
    
    <Property Name="CommandletErrorLevel" Value="1" />
    <Property Name="CommandletErrorLevel" Value="4" If="$(IsBuildMachine)"/>
    <Property Name="CommandletCommonArguments" Value="-SCCProvider=None -log -nopause -unattended -nosplash -nofastbuildcontroller" />

    <Property Name="PostEditorTestsExtendFile" Value="$(ProjectPath)/Scripts/Build/Buildgraph/Validation.xml" />
    
    <Include Script="$(RootDir)/Engine/Build/Graph/Tasks/BuildAndTestProject.xml" />

    <Property Name="BuildAndTestExtendedRequirements" Value="BuildAndTest $(ProjectName)" />
    
    <Aggregate Name="BuildAndTestExtended $(ProjectName)" Requires="$(ValidationNodes);$(BuildAndTestExtendedRequirements);" />

</BuildGraph>