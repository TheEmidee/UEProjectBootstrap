<?xml version='1.0' ?>
<BuildGraph xmlns="http://www.epicgames.com/BuildGraph" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.epicgames.com/BuildGraph ../../../../Engine/Build/Graph/Schema.xsd">

<Option Name="Skip_Validation_All" DefaultValue="false" Restrict="true|false" Description="Skip all validation checks?" />	
<Option Name="Skip_Validation_NamingConventionValidation" Restrict="true|false" DefaultValue="false" Description="Skip the Naming Convention validation?" />
<Option Name="Skip_Validation_CheckNoRedirectors" Restrict="true|false" DefaultValue="false" Description="Skip the Check No Redirectors validation?" />

<Property Name="CommandletErrorLevel" Value="1" />
<Property Name="CommandletErrorLevel" Value="4" If="$(IsBuildMachine)"/>
<Property Name="CommandletCommonArguments" Value="-SCCProvider=None -log -nopause -unattended -nosplash -nofastbuildcontroller" />

<Extend Name="PostEditorPlatformStep">
    <Agent Name="Check No Redirectors" Type="$(TestAgentType)">
        <Node Name="Check No Redirectors" Requires="$(GeneratedToolNodes)">
            <Commandlet Name="CheckNoRedirectors" ErrorLevel="$(CommandletErrorLevel)" Project="$(ProjectFile)" Arguments="$(CommandletCommonArguments) -log -log=CheckNoRedirectors.log" />
            <!-- <GenerateJenkinsCompatibleWarningsFile LogFile="$(LogsDirectory)/CheckNoRedirectors.log" Category="CheckNoRedirectors" OutputFile="$(Test_WarningsDirectory)/CheckNoRedirectors.txt" Append="False" WarningMessagesToIgnoreFile="$(ProjectDir)/Scripts/Build/Buildgraph/WarningMessagesToIgnore.txt" /> -->
        </Node>
    </Agent>

    <Do If="!$(Skip_Validation_All)">
        <Property Name="GeneratedCookedEditorTestNodes" Value="$(GeneratedCookedEditorTestNodes);YOURGAME Compile Editor Win64" />
        <Property Name="GeneratedCookedEditorTestNodes" Value="$(GeneratedCookedEditorTestNodes);Check No Redirectors" If="!$(Skip_Validation_CheckNoRedirectors)" />
    </Do>
</Extend>

</BuildGraph>